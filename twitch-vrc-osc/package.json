{
  "name": "twitch-vrc-osc",
  "version": "1.0.0",
  "description": "Recompensas de puntos de canal de Twitch -> VRChat OSC (avatar / atuendos)",
  "author": "DKA46",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": { "electron-updater": "^6.3.9" },
  "devDependencies": { "electron": "^33.4.11", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.DKA46.twitchvrcosc",
    "productName": "Twitch VRChat OSC",
    "files": ["main.js", "preload.js", "vrchat.js", "index.html", "renderer.js", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false },
    "publish": [{ "provider": "github", "owner": "DKA46", "repo": "VRC-twitch-HelpofC" }]
  }
}
